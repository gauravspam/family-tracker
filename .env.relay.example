# ---- Database ----
# URL-encoded password; schema must be 'relay'
DATABASE_URL='postgres://relay_user:YOUR_RELAY_PASSWORD@localhost/postgres?search_path=relay&sslmode=disable'

# ---- Traccar ----
TRACCAR_BASE_URL='http://traccar:8082'
TRACCAR_ADMIN_USER='admin@family-tracker.local'
TRACCAR_ADMIN_PASSWORD='YOUR_TRACCAR_PASSWORD'

# ---- Relay ----
RELAY_WEBHOOK_SECRET='generate-a-random-32-byte-base64-secret'
RELAY_ADMIN_TOKEN='some-secret-token-for-admin-api-calls'
RELAY_PORT='8080'

# ---- Ingest (Traccar GPS port) ----
INGEST_URL='http://traccar:5055'

# ---- FCM ----
# Path to the Firebase service-account JSON inside the container
FCM_SERVICE_ACCOUNT_JSON='/app/secrets/fcm-service-account.json'
