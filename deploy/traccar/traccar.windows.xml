<?xml version='1.0' encoding='UTF-8'?>

<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>

<!-- Windows local dev (portable Postgres + Traccar, no Docker).
     Ubuntu/Docker uses traccar.xml — keep the two files separate. -->
<properties>

  <!-- PostgreSQL — traccar schema, traccar_user only (native Windows Postgres) -->
  <entry key='database.driver'>org.postgresql.Driver</entry>
  <entry key='database.url'>jdbc:postgresql://localhost:5432/postgres?currentSchema=traccar</entry>
  <entry key='database.user'>traccar_user</entry>
  <entry key='database.password'>dSIVRok6jl4YakptQICM7B6j9YNmW3NjBM1niBw8G28=</entry>

  <!-- Security: ONLY relay-provisioned devices may ingest positions -->
  <entry key='database.registerUnknown'>false</entry>

  <!-- OsmAnd ingest port -->
  <entry key='osmand.port'>5055</entry>

  <!-- Geofence event forwarding to relay (both run natively on this PC) -->
  <entry key='event.forward.type'>json</entry>
  <entry key='event.forward.url'>http://127.0.0.1:8080/webhook/traccar/event</entry>
  <entry key='event.forward.header'>X-Relay-Secret: hm8AnrC/GHdS/nu8dqkqJvOspABxOn4H6qRy5nTC2PY=</entry>

  <!-- Registration closed: admin account already created -->
  <entry key='registration'>false</entry>

</properties>
